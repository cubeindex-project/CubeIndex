{
  "name": "cubeindex",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "host": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "update-types": "supabase gen types --lang=typescript --project-id \"$PROJECT_REF\" > ./src/lib/types/database-generated.types.ts",
    "db:start": "supabase start",
    "db:restart": "supabase stop && npx supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-netlify": "^7.0.1",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/culori": "^4.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "supabase": "^3.2.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "svelte-turnstile": "^0.11.0",
    "sveltekit-superforms": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-devtools-json": "^1.1.2",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@axiomhq/pino": "^2.0.0",
    "@mdit/plugin-alert": "^2.2.0",
    "@mdit/plugin-emoji": "^1.3.0",
    "@mdit/plugin-footnote": "^1.2.0",
    "@number-flow/svelte": "^0.4.2",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@umami/node": "^0.4.0",
    "chart.js": "^4.6.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "culori": "^4.0.2",
    "daisyui": "^5.8.1",
    "dompurify": "^3.4.18",
    "file-type": "^22.3.0",
    "fuse.js": "^7.5.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "nuqs-svelte": "^1.2.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "svelte-exmarkdown": "^5.0.2",
    "svelte-sonner": "^1.2.3",
    "sveltekit-top-loading": "^0.1.0",
    "theme-change": "^3.0.4",
    "type-fest": "^6.0.2",
    "valibot": "^1.5.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "sharp@0.34.5": true
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
